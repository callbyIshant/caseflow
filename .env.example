ENV=development
APP_NAME=CaseFlow
PUBLIC_APP_URL=http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql+psycopg://caseflow:caseflow@localhost:5433/caseflow
DATABASE_URL_DIRECT=postgresql+psycopg://caseflow:caseflow@localhost:5433/caseflow
CSRF_SECRET=replace-with-a-random-development-secret-of-at-least-32-characters
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
COOKIE_NAME=caseflow_dev_session
LOG_LEVEL=INFO
ALLOW_DEMO_SEED=false
